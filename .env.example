# =============================================================================
# Azure AI Foundry / Azure OpenAI Configuration
# =============================================================================

# Your Azure OpenAI endpoint (found in Azure AI Foundry > Project > Overview)
# e.g. https://YOUR_RESOURCE_NAME.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Your Azure OpenAI API Key (found in Azure AI Foundry > Project > Keys)
AZURE_OPENAI_API_KEY=your_api_key_here

# API Version - use this for structured outputs support
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# =============================================================================
# Deployment Names
# Configure these to match your deployed model names in Azure AI Foundry
# =============================================================================

# GPT-4o-mini deployment used for fast CV text extraction
AZURE_OPENAI_EXTRACTION_DEPLOYMENT=gpt-4o-mini

# GPT-4o deployment used for complex career graph generation
AZURE_OPENAI_GRAPH_DEPLOYMENT=gpt-4o

# =============================================================================
# (Optional) Azure AI Foundry Project Connection String
# Use this if you want to leverage Azure AI Project features (tracing, evals)
# Found in: Azure AI Foundry > Your Project > Overview > Project connection string
# =============================================================================
# AZURE_AI_PROJECT_CONNECTION_STRING=your_project_connection_string_here
